#!/bin/sh
# The installed package runs, reports a version, and documents itself.
set -eu

echo "--- whytop -version"
whytop -version

v=$(whytop -version | awk '{print $2}')
test -n "$v" || { echo "no version reported"; exit 1; }
case "$v" in
	dev|"") echo "the packaged binary reports '$v' rather than its upstream version"; exit 1 ;;
esac
echo "version: $v"

echo "--- the binary is where the package says it is"
test -x /usr/bin/whytop

echo "--- the manual page is installed and gzipped"
test -f /usr/share/man/man1/whytop.1.gz

echo "--- --help exits cleanly and names the flags"
# Go's flag package exits 2 on -h, which is not a failure.
out=$(whytop -h 2>&1 || true)
for flag in -host -pid -port -no-update-check; do
	echo "$out" | grep -q -- "$flag" || { echo "-h does not mention $flag"; exit 1; }
done

echo "--- refuses to start without a terminal rather than hanging"
# No controlling terminal here. whytop must fail or exit, not block the
# test runner forever.
timeout 20 whytop -i 1s </dev/null >/dev/null 2>&1 || true
echo "returned within the timeout"

echo "PASS"
